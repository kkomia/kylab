{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KYLAB",
  "version": "0.1.0",
  "identifier": "com.kylab.desktop",
  "build": {
    "frontendDist": "../../shell/src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' app:; script-src 'self' app:; style-src 'self' app: 'unsafe-inline'; img-src 'self' app: data: blob:; font-src 'self' app: data:; connect-src 'self' app: ipc: http://ipc.localhost; media-src 'self' app: data: blob:; worker-src 'self' app: blob:; frame-src 'self' app:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../build/sidecar-runtime": "sidecar-runtime"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
