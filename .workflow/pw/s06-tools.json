    { "kind": "fill", "selector": "#login-password", "value": "117118363", "timeout": 4000 },
    { "kind": "click", "selector": "button[type=\"submit\"]", "settle": 2500, "timeout": 4000 },

    { "kind": "goto", "url": "/chat", "settle": 2500 },
    { "kind": "fill", "selector": "textarea[aria-label=\"消息输入框\"]", "value": "请分两步完成，不要问我问题：第一步，在我的知识库里检索「眼眶血管性疾病」相关的原文段落并给出来源；第二步，把结论整理成一份 Markdown 文件，文件名 eye.md，写到本会话的文件区。做完用一句话汇报。" },
    { "kind": "wait", "ms": 800 },
    { "kind": "shot", "path": "30-tool-task-sent.png" },
    { "kind": "press", "selector": "textarea[aria-label=\"消息输入框\"]", "key": "Enter", "settle": 3000 },
    { "kind": "shot", "path": "31-tool-running.png" },
    { "kind": "wait", "ms": 6000 },
    { "kind": "shot", "path": "32-tool-mid.png" },
    { "kind": "eval", "code": "JSON.stringify({stop:!!document.querySelector('button[aria-label=\"停止生成\"]'), kinds:[...document.querySelectorAll('[data-kind]')].map(e=>e.getAttribute('data-kind')), texts:[...document.querySelectorAll('[data-kind]')].map(e=>e.innerText.replace(/\\n/g,' | ').slice(0,110))})" },
    { "kind": "wait", "ms": 15000 },
    { "kind": "shot", "path": "33-tool-later.png" },
    { "kind": "eval", "code": "JSON.stringify({stop:!!document.querySelector('button[aria-label=\"停止生成\"]'), kinds:[...document.querySelectorAll('[data-kind]')].map(e=>e.getAttribute('data-kind')), texts:[...document.querySelectorAll('[data-kind]')].map(e=>e.innerText.replace(/\\n/g,' | ').slice(0,140))})" },
    { "kind": "waitFor", "selector": "button[aria-label=\"停止生成\"]", "state": "detached", "timeout": 180000 },
    { "kind": "wait", "ms": 1500 },
    { "kind": "shot", "path": "34-tool-done.png" },
    { "kind": "eval", "code": "JSON.stringify({url:location.pathname, stop:!!document.querySelector('button[aria-label=\"停止生成\"]'), kinds:[...document.querySelectorAll('[data-kind]')].map(e=>e.getAttribute('data-kind')), texts:[...document.querySelectorAll('[data-kind]')].map(e=>e.innerText.replace(/\\n/g,' | ').slice(0,180)), aria:[...document.querySelectorAll('[aria-label]')].map(e=>e.getAttribute('aria-label')).filter(Boolean)})" },
    { "kind": "text", "selector": "[data-testid=\"reply-text\"]", "limit": 2000 },
    { "kind": "scroll", "selector": "[aria-label=\"对话内容\"]", "y": 0, "settle": 600 },
    { "kind": "shot", "path": "35-trace-top.png" }
  ]
