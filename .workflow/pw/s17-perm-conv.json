    { "kind": "eval", "code": "JSON.stringify({approval:!!document.querySelector('[role=\"alert\"], [aria-label*=\"审批\"], [aria-label*=\"确认\"]'), steps:[...document.querySelectorAll('[data-kind]')].map(e=>e.getAttribute('data-kind')+' | '+e.innerText.replace(/\\n/g,' ').slice(0,120))})" },
