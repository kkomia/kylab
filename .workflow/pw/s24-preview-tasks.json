    { "kind": "note", "value": "translation task" },
    { "kind": "fill", "selector": "textarea[aria-label=\"消息输入框\"]", "value": "把下面这句翻译成英文，只给译文：眼眶血管性疾病分为血管瘤和血管畸形两大类。" },
