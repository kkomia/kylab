# KYLAB 后端环境变量模板
#
# 用法：复制本文件为 backend/.env（可选）。.env 已被 .gitignore 忽略，
# 任何 token / API key 禁止提交（工程规范 §6）。
#
# 这里只放**进程级**配置。凭据与模型一律在网页上配：
#   侧栏底部「设置」→ 模型配置（向量化 / 重排）/ 服务配置（MinerU / PaddleOCR）/ 对话模型（LLM）
# 它们落 SQLite 的 app_settings 表，改完即刻生效，不必重启（架构设计 v0.2 §13）。
#
# 本文件里的 KYLAB_* 只作**引导默认值**：网页上写过一次之后，以数据库里的值为准。

# ---- 服务 ----
KYLAB_HOST=127.0.0.1
KYLAB_PORT=8000
KYLAB_LOG_LEVEL=INFO
KYLAB_DATA_DIR=./data
KYLAB_CORS_ORIGINS=http://127.0.0.1:5173

# ---- 鉴权（上局域网前必读，架构设计 v0.2 §3.2）----
#
# 默认**不启用**：本机单人开发每次带令牌纯属折磨，而默认开启会让升级后所有既有
# 客户端立刻 401（最难排查的一类故障）。
#
# 但"关着"不等于不设防，下面任一条件成立时鉴权会自动开始生效：
#   1. KYLAB_AUTH_ENABLED=true
#   2. KYLAB_CONSOLE_TOKEN 有值
#   3. 库里已经存在任何 API Key（能配出凭据，就说明你要鉴权）
KYLAB_AUTH_ENABLED=false
#
# 控制台令牌：Web 控制台用它访问设置页（管理员身份）。
# **为什么必须单独一把**：设置页是 embedding / rerank / LLM 密钥的落点，
# 且 base_url 可改——外部 API Key 若能碰它，就能把 base_url 指向自己的服务器，
# 下一次调用就把你的 API Key 以 Authorization: Bearer 发过去。
# 所以设置端点只认控制台令牌，外部 API Key 一律 403。
#
# 生成方式：openssl rand -hex 32
KYLAB_CONSOLE_TOKEN=
#
# 外部集成的 API Key 不在 .env 里配，而是走接口发（明文只在创建响应出现一次）：
#   POST /api/v1/api-keys  {"name":"给 Grafana 的只读钥匙","permission":"readonly",
#                           "knowledge_base_ids":["kb_xxx"]}
# 调用时带 Authorization: Bearer kylab_sk_...
# permission 为 readonly / readwrite；knowledge_base_ids 留空表示不限制范围。

# ---- 可选：部署时预设一次凭据（留空即可，之后在网页上填）----
#
# MinerU token 有效期 90 天且不可续期，设置页会提示过期（架构设计 v0.2 §12、§15）
KYLAB_MINERU_TOKEN=
KYLAB_PADDLEOCR_TOKEN=

# 向量化：库内已有向量后换模型会被拒绝；换 endpoint 时模型 ID 必须一致（架构 §6.4）
#
# 关于向量维度（M1 决策 D4）：维度不是全局常量，而是每个知识库的属性，随库记录
# （embedding_model_id + embedding_dim），向量表按知识库分区、建表时使用该库的维度。
# 默认候选：BAAI/bge-m3（1024 维，中文友好）。
KYLAB_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
KYLAB_EMBEDDING_API_KEY=
KYLAB_EMBEDDING_MODEL=

# 对话模型（LLM）：与 embedding 是**两个不同的模型**，embedding 只做向量化、不会说话。
# 默认候选：Qwen/Qwen3.5-4B（硅基流动上免费的那档），适合快速验证。
# 注意它默认会先输出思考过程，把 max_tokens 吃光后正文为空——
# 所以设置页里「深度思考」默认关闭，需要更高质量时再打开并调大最大回复长度。
KYLAB_LLM_BASE_URL=https://api.siliconflow.cn/v1
KYLAB_LLM_API_KEY=
KYLAB_LLM_MODEL=
