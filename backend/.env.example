# KYLAB 本机后端环境变量模板
#
# 用法：复制本文件为 backend/.env（可选）。.env 已被 .gitignore 忽略，
# 任何 token / API key 禁止提交（工程规范 §6）。
#
# 这里只放**引导级**配置：连不上就起不来的东西（数据目录、本机库文件、
# 接的那台知识库提供者的地址与凭据）。它们只能来自环境变量——
# "把凭据存进自己的库"是鸡生蛋。
#
# 其余可改的运行期配置一律在界面上配：
#   侧栏底部 →「设置」→ 模型注册 / 向量化 / 对话模型 / 服务配置
# 它们落本机库、改完即刻生效、不必重启，且密钥只回显掩码。
# 所以下面**没有** embedding / LLM 的地址与密钥：那些属于"登记了哪个模型"，
# 由模型注册表承担。

# ---- 服务 ----
KYLAB_HOST=127.0.0.1
KYLAB_PORT=8000
KYLAB_LOG_LEVEL=INFO
KYLAB_DATA_DIR=./data
KYLAB_CORS_ORIGINS=http://127.0.0.1:5173

# 本机消费者：定时任务到点跑 + 本机库空闲维护。
# 测试里关掉它，改为手动驱动，避免时序不确定。
KYLAB_RUN_WORKER=true
# 任务租约时长（秒）
KYLAB_WORKER_LEASE_SECONDS=60
# 同时跑几件事的上限（1–8，默认 1）：只影响负载面板报的并发槽位与定时任务排队观感。
KYLAB_WORKER_CONCURRENCY=1
# MinerU 每日优先额度的页数（官方口径 1000 页/天）。超了不是报错，是**降级排队**
# ——用户只会看到"卡住不动"，所以负载面板把"今日已用 / 额度"显示出来。
# 这是本地记账（按今日解析过的页数累加），不是向云端查的真实剩余量。
KYLAB_MINERU_DAILY_PAGE_QUOTA=1000

# ---- 存储 ----
#
# **只有本机一套**：元数据落在 KYLAB_DATA_DIR 下的 kylab.db（SQLite），
# 原件 / Markdown 产物 / 图片落在 data_dir/{originals,markdown,images}。
# 装配点只有一处：app/core/storage.py::build_stores()，启动时校验（版本、schema、写锁）。
#
# 服务器档那三份实现（PostgreSQL + 对象存储 + DuckDB）随知识库产品剥离一起删了，
# 所以这里不再有 KYLAB_DATABASE_URL / KYLAB_S3_* 那几组配置；
# 环境里若还留着它们会被静默忽略，不影响启动。
#
# 库文件路径可以覆盖（把库放到另一个盘、或排障时指向别处）：
# 不填就是 <KYLAB_DATA_DIR>/kylab.db
KYLAB_LOCAL_DB=

# ---- 知识库提供者（本机是它的客户端）----
#
# 知识库（检索与入库）在**另一台机器**上，本机不持有那些数据。
# 不填 = 这台机器这次没接：检索会如实报"知识库不可用"，而不是回一个空的命中列表。
#
# 那台机器的 API 基址（含 /api/v1）。旧会话导入的来源也读它。
KYLAB_SERVER_URL=
# 那台机器的会话令牌（与桌面壳、前端用的是同一把）。不落库、不进日志。
KYLAB_TOKEN=
# 提供者地址的**覆盖**（排障 / 换一台机器时用）。不填就继承 KYLAB_SERVER_URL。
KYLAB_KB_URL=
# 提供者凭据的**覆盖**。不填就继承 KYLAB_TOKEN。
KYLAB_KB_TOKEN=

# ---- 本机身份 ----
#
# 设备身份：桌面壳生成、每次起边车时用 --device-id 传下来。
# **绝不自动生成**——编一个 id 会让同一台机器在远端长出两套互不相认的恢复点，
# 而"恢复时该信哪一份"就没有答案了。没有它时打快照会被如实拒绝。
# 手工起后端时按需填；壳那条路不用管这里。
KYLAB_DEVICE_ID=

# 下载签名 URL 的密钥。浏览器里 <img> 与下载链接带不了 Authorization 头，
# 所以"有权访问"要编码进 URL 本身。
# 留空即可：组合根在启动装配时会生成一条并落库（幂等，不会每次换）。
KYLAB_URL_SIGNING_SECRET=

# ---- 可选：预设一次云端解析凭据（留空即可，之后在界面上填）----
#
# MinerU token 有效期 90 天且不可续期，设置页会提示过期
KYLAB_MINERU_TOKEN=
KYLAB_PADDLEOCR_TOKEN=

# 浏览 GitHub 上的技能源时用的 token（可选）。不给也能用，
# 只是匿名配额是 60 次/小时/IP；给了提到 5000 次/小时。
KYLAB_GITHUB_TOKEN=

# ---- 行为参数（不是模型身份）----
#
# 模型身份（地址 / 密钥 / 名称 / 维度）在「设置 → 模型注册」里登记，不在环境变量里。
# 这里只有影响调用方式的行为参数。

# 单次 embedding 请求的文本条数。太大可能被端点拒绝。
KYLAB_EMBEDDING_BATCH_SIZE=32

# 嵌入协议：openai（默认）/ wemm。
#
#   openai  OpenAI 兼容端点（云端各家 / 本机 Ollama / vLLM）——默认值，行为与从前一致；
#   wemm    局域网 WeMM-Embedding-2B 多模态（llama.cpp）：**文本走同一个 OpenAI 兼容口**，
#           另有图片/视频那条三步媒体协议（现取 media_marker → base64 → POST /embedding），
#           三种模态共享同一向量空间（一句文字就能搜到图），详见
#           docs/归档/调研/WeMM-Embedding-2B-接入文档-v0.1.md。
# 地址不写在这里——它属于"注册了哪个供应商"，在「设置 → 模型注册」里登记时填。
#
# 这一项只是**引导值**：界面上改过之后以库里的为准（与批大小同一条规则）。
KYLAB_EMBEDDING_PROTOCOL=openai

# 开发用确定性嵌入（哈希）开关，**默认关闭，生产不要开**。
# 关闭时"没配嵌入模型"就是真没配：界面如实说明。
# 打开它才会退回无语义的词面哈希——只为离线开发与测试留一条不联网的链路。
KYLAB_DEV_EMBEDDING=false

# 对话模型的采样与思考开关
KYLAB_LLM_TEMPERATURE=0.3
# 思考开关默认开：主流模型默认都思考，关掉是例外而不是常态。
# 不同供应商用不同字段表达（DeepSeek 认 thinking.type、Qwen 认 enable_thinking）。
KYLAB_LLM_ENABLE_THINKING=true
# 思考强度：low / medium / high，同样按方言翻译或丢弃
KYLAB_LLM_THINKING_EFFORT=medium

# ---- 长期记忆与 agent 模式（都只是引导值，界面改过之后以库里的为准）----
# 记忆是否启用（默认关：开着它对话收尾会真的调一次模型做自动沉淀）
KYLAB_MEMORY_ENABLED=
# 记忆工作区目录（相对数据目录，默认 memory）
KYLAB_MEMORY_WORKSPACE=
# agent 模式四档 plan / build / edit / yolo（默认 build）
KYLAB_CHAT_MODE=
