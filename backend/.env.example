# KYLAB 后端环境变量模板
#
# 用法：复制本文件为 backend/.env 后填写。
# 注意：.env 已被 .gitignore 忽略，任何 token / API key 禁止提交（工程规范 §6）。
# 用户级配置（解析节点、API Key、embedding 模型）运行期落 SQLite，不写本文件。

# ---- 服务 ----
KYLAB_HOST=127.0.0.1
KYLAB_PORT=8000
KYLAB_LOG_LEVEL=INFO
KYLAB_DATA_DIR=./data
KYLAB_CORS_ORIGINS=http://127.0.0.1:5173

# ---- 云端解析节点（M2 启用）----
# MinerU token 有效期 90 天且不可续期，控制台需展示过期时间（架构设计 v0.2 §12、§15）
KYLAB_MINERU_TOKEN=
KYLAB_PADDLEOCR_TOKEN=

# ---- Embedding（M2 启用）----
# 库内已有向量时不允许更换模型；换 endpoint 时模型 ID 必须一致（架构设计 v0.2 §6.4）
#
# 关于向量维度（M1 决策 D4）：维度不是全局常量，而是每个知识库的属性，随库记录
# （embedding_model_id + embedding_dim），向量表按知识库分区、建表时使用该库的维度。
# 因此这里只给"默认候选"，实际取值由用户在设置页决定；库一旦向量化即冻结模型 ID。
# 默认候选：BAAI/bge-m3（1024 维，中文友好，硅基流动免费额度覆盖）
KYLAB_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
KYLAB_EMBEDDING_API_KEY=
KYLAB_EMBEDDING_MODEL=
