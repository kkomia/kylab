# ---- 密钥与本地配置（工程规范 §6：任何 token/API key 禁止提交）----
.env
.env.*
!.env.example

# ---- 运行期数据（SQLite、上传原文、Markdown 产物、图片）----
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.trash/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# ---- Node / 前端 ----
node_modules/
frontend/dist/
.vite/
*.log

# ---- E2E 产物 ----
test-results/
playwright-report/

# ---- 编辑器与系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 前端构建/类型检查产物 ----
*.tsbuildinfo

# ---- 本地视觉复核工作区（截图与夹具，仅本机使用）----
.shots/
.playwright-mcp/

# ---- npm 的锁文件：本仓库用 pnpm（pnpm-lock.yaml），
#      误用 npm install 时不希望它被提交（工程规范 §6）----
package-lock.json
