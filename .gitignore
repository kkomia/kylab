# ---- 密钥与本地配置（工程规范 §6：任何 token/API key 禁止提交）----
.env
.env.*
!.env.example

# ---- 运行期数据（SQLite、上传原文、Markdown 产物、图片）----
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.trash/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# ---- Node / 前端 ----
node_modules/
frontend/dist/
.vite/
*.log

# ---- E2E 产物 ----
test-results/
playwright-report/

# ---- 走查脚本用的浏览器 profile：带登录态且 100MB+，绝不入库 ----
.workflow/pw/.pwprofile/

# ---- 2026-09-28 走查：kimi-webbridge 的临时请求体与调用脚本（该路线已弃用）----
.workflow/wb.ps1
.workflow/wb-multi.ps1
.workflow/shot.ps1
.workflow/req-*.json

# ---- 编辑器与系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db

# ---- 前端构建/类型检查产物 ----
*.tsbuildinfo

# ---- 本地视觉复核工作区（截图与夹具，仅本机使用）----
.shots/
.playwright-mcp/

# ---- 编辑器/工具状态（ZCode 的计划模式产物等，仅本机）----
.zcode/

# ---- npm 的锁文件：本仓库用 pnpm（pnpm-lock.yaml），
#      误用 npm install 时不希望它被提交（工程规范 §6）----
package-lock.json

# 迁移期：上游参考仓库的浅克隆缓存（只读参考，不进版本库）
.cache/

# ---- 本机跑测试/自检留下的产物（都能再生，且不属于仓库）----
# jieba 的分词缓存：进程的工作目录在哪它就写在哪，跑一次后端用例就会冒出来
jieba.cache
# pytest 的临时目录（`tmp_path` 的落点）：本机 TEMP 指向仓库根时会留在 backend/ 下
pytest-of-*/

